# Supabase (browser / Vite — public anon key only)
# Set the same two names in Vercel → Project → Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — local scripts only (never add to Vercel / never commit)
# Used by scripts/sim-seven-day.mjs for controlled backdating.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
