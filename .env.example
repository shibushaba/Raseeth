# Supabase (browser / Vite — public anon key only)
# Set the same two names in Vercel → Project → Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — local scripts only (never add to Vercel / never commit)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ACCESS_TOKEN=sbp_...   # npm run db:push (Management API)
# SUPABASE_DB_PASSWORD=your-database-password   # npm run db:push:postgres
# Or full URL: SUPABASE_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
